# Copier ce fichier vers .env puis modifier les valeurs.
# Le fichier .env réel ne doit jamais être envoyé dans GitHub.

# =========================
# Docker ports publics
# =========================
FRONTEND_PORT=5173
BACKEND_PORT=8000
PHPMYADMIN_PORT=8081
MYSQL_PUBLIC_PORT=3307

# =========================
# Django
# =========================
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change_this_django_secret_key
DJANGO_DEBUG=True

# Exemple :
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend,YOUR_SERVER_IP
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend,YOUR_SERVER_IP

# =========================
# Base de données MariaDB/MySQL
# =========================
MYSQL_DATABASE=change_this_database_name
MYSQL_USER=change_this_database_user
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# Backup directory utilisé par le backend.
# En Docker, ce dossier est monté depuis ./backups vers /app/backups.
BACKUP_DIR=./backups

# Important :
# Dans Docker Compose, MYSQL_HOST doit être le nom du service MariaDB.
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60

# =========================
# Superuser Django optionnel
# À utiliser seulement si ton projet crée automatiquement un admin.
# =========================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change_this_admin_password

# =========================
# MikroTik
# =========================
MIKROTIK_BASE_URL=http://YOUR_ROUTER_IP/rest
MIKROTIK_USERNAME=change_this_mikrotik_username
MIKROTIK_PASSWORD=change_this_mikrotik_password
MIKROTIK_VERIFY_SSL=false
MIKROTIK_HOTSPOT_PROFILE=change_this_hotspot_profile
MIKROTIK_ENABLE_HOTSPOT_SYNC=true

# =========================
# CORS / CSRF
# =========================
# Exemple :
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_SERVER_IP:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_SERVER_IP:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_SERVER_IP:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_SERVER_IP:5173

# Regex optionnel pour autoriser un réseau local complet.
# Exemple pour 192.168.1.x :
CORS_ALLOWED_ORIGIN_REGEXES=^http://192\.168\.1\.[0-9]{1,3}:5173$

# =========================
# Frontend Vite
# =========================
# PUBLIC dans le navigateur.
# Ne jamais mettre de mot de passe dans une variable qui commence par VITE_.
VITE_API_BASE_URL=http://localhost:8000